# GridWise Environment Configuration Template
# Copy this file to .env and set your actual credentials.
# WARNING: Never commit .env with real secrets to version control!

# Required: Google Gemini API Key for note interpretation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: Network binding & port (default: 0.0.0.0, 8000)
HOST=0.0.0.0
PORT=8000

# Optional: Environment mode (production / development)
ENVIRONMENT=production
